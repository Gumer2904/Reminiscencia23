    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        // Inicializar AOS
        AOS.init({
            once: true,
            duration: 1000,
            offset: 100
        });
        
        // Static sidebar functionality for mobile
        const menuToggle = document.getElementById('menuToggle');
        const sidebar = document.getElementById('sidebar');
        
        function toggleSidebar() {
            if (window.innerWidth <= 768) {
                sidebar.classList.toggle('mobile-open');
            }
        }
        
        menuToggle.addEventListener('click', toggleSidebar);
        
        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', function(e) {
            if (window.innerWidth <= 768) {
                if (!sidebar.contains(e.target) && !menuToggle.contains(e.target)) {
                    sidebar.classList.remove('mobile-open');
                }
            }
        });
        
        // Handle window resize
        window.addEventListener('resize', function() {
            if (window.innerWidth > 768) {
                sidebar.classList.remove('mobile-open');
            }
        });
        
        // Top bar scroll effect
        const topBar = document.getElementById('topBar');
        window.addEventListener('scroll', function() {
            if (window.scrollY > 50) {
                topBar.classList.add('scrolled');
            } else {
                topBar.classList.remove('scrolled');
            }
        });
        
        // Smooth scroll for all anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
        
        // Download app function
        function downloadApp(type) {
            if (type === 'mobile') {
                // Create download modal for mobile app
                showDownloadModal('mobile');
            } else if (type === 'desktop') {
                // Create download modal for desktop app
                showDownloadModal('desktop');
            }
        }
        
        function showDownloadModal(type) {
            const modal = document.createElement('div');
            modal.className = 'modal fade';
            modal.innerHTML = `
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="bi bi-${type === 'mobile' ? 'phone' : 'laptop'}"></i>
                                Descargar Stock Manager para ${type === 'mobile' ? 'Móvil' : 'Escritorio'}
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="download-options">
                                ${type === 'mobile' ? `
                                    <div class="platform-option">
                                        <h6><i class="bi bi-android"></i> Android</h6>
                                        <p>Compatible con Android 8.0 o superior</p>
                                        <button class="btn btn-success w-100" onclick="startDownload('mobile', 'android')">
                                            <i class="bi bi-download"></i> Descargar APK
                                        </button>
                                    </div>
                                    <div class="platform-option">
                                        <h6><i class="bi bi-apple"></i> iOS</h6>
                                        <p>Compatible con iOS 12.0 o superior</p>
                                        <button class="btn btn-primary w-100" onclick="startDownload('mobile', 'ios')">
                                            <i class="bi bi-app-store"></i> App Store
                                        </button>
                                    </div>
                                ` : `
                                    <div class="platform-option">
                                        <h6><i class="bi bi-windows"></i> Windows</h6>
                                        <p>Compatible con Windows 10 o superior</p>
                                        <button class="btn btn-primary w-100" onclick="startDownload('desktop', 'windows')">
                                            <i class="bi bi-download"></i> Descargar Installer
                                        </button>
                                    </div>
                                    <div class="platform-option">
                                        <h6><i class="bi bi-apple"></i> macOS</h6>
                                        <p>Compatible con macOS 10.14 o superior</p>
                                        <button class="btn btn-secondary w-100" onclick="startDownload('desktop', 'mac')">
                                            <i class="bi bi-download"></i> Descargar DMG
                                        </button>
                                    </div>
                                    <div class="platform-option">
                                        <h6><i class="bi bi-ubuntu"></i> Linux</h6>
                                        <p>Compatible con Ubuntu 18.04 o superior</p>
                                        <button class="btn btn-warning w-100" onclick="startDownload('desktop', 'linux')">
                                            <i class="bi bi-download"></i> Descargar AppImage
                                        </button>
                                    </div>
                                `}
                            </div>
                            <div class="download-info mt-3">
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle"></i>
                                    <strong>Información:</strong> Las aplicaciones son completamente gratuitas para usuarios registrados. 
                                    Se requiere una cuenta activa para sincronizar datos.
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        </div>
                    </div>
                </div>
            `;
            
            document.body.appendChild(modal);
            const bootstrapModal = new bootstrap.Modal(modal);
            bootstrapModal.show();
            
            // Clean up modal
            modal.addEventListener('hidden.bs.modal', () => {
                document.body.removeChild(modal);
            });
        }
        
        function startDownload(type, platform) {
            // Close modal
            const modal = document.querySelector('.modal.show');
            if (modal) {
                bootstrap.Modal.getInstance(modal).hide();
            }
            
            // Show download notification
            showNotification(`Iniciando descarga para ${platform}...`, 'info');
            
            // Simulate download start
            setTimeout(() => {
                if (type === 'mobile') {
                    if (platform === 'android') {
                        window.location.href = 'mobile-app/stock-manager-mobile.apk';
                    } else if (platform === 'ios') {
                        window.open('https://apps.apple.com/stock-manager', '_blank');
                    }
                } else if (type === 'desktop') {
                    if (platform === 'windows') {
                        window.location.href = 'desktop-app/dist/Stock-Manager-Setup.exe';
                    } else if (platform === 'mac') {
                        window.location.href = 'desktop-app/dist/Stock-Manager.dmg';
                    } else if (platform === 'linux') {
                        window.location.href = 'desktop-app/dist/Stock-Manager.AppImage';
                    }
                }
                
                showNotification('Descarga iniciada correctamente', 'success');
            }, 1500);
        }
        
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            notification.style.cssText = 'top: 100px; right: 20px; z-index: 9999; min-width: 300px;';
            notification.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            document.body.appendChild(notification);
            
            // Auto remove after 5 seconds
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.parentNode.removeChild(notification);
                }
            }, 5000);
        }
    </script>
</body>
</html>