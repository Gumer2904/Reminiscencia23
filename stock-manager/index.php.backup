<?php
require_once 'includes/config.php';
require_once 'includes/database.php';
require_once 'includes/auth.php';

// Si ya está logueado, redirigir al dashboard
if ($auth->isLoggedIn()) {
    header('Location: dashboard.php');
    exit();
}

// Obtener estadísticas para mostrar en la página (opcional)
$total_empresas = 0;
$total_productos = 0;
$total_usuarios = 0;

$db->query("SELECT COUNT(*) as total FROM empresas");
$result = $db->single();
$total_empresas = $result ? $result->total : 0;

$db->query("SELECT COUNT(*) as total FROM productos");
$result = $db->single();
$total_productos = $result ? $result->total : 0;

$db->query("SELECT COUNT(*) as total FROM usuarios");
$result = $db->single();
$total_usuarios = $result ? $result->total : 0;
?>
